# Copie para .env e ajuste. Nunca publique o arquivo .env.
PORT=3000
# Troque por um texto longo e aleatório (obrigatório em produção)
JWT_SECRET=troque-este-segredo
# Primeiro acesso da central (criado na primeira vez que o servidor liga)
