# Copie para .env e ajuste. Nunca publique o arquivo .env.
PORT=3000
# Opcional: segredo dos logins. Se ficar em branco, o sistema cria um sozinho e guarda na pasta data/.
JWT_SECRET=
# Primeiro acesso da central (criado na primeira vez que o servidor liga)
ADMIN_PHONE=11999990000
ADMIN_PASSWORD=troque-esta-senha
# Ligue (=1) quando o servidor estiver atrás de um proxy/hospedagem que repassa o IP do visitante
TRUST_PROXY=
# Onde o banco de dados fica salvo
DB_PATH=./data/mototaxi.db

# Opcional: pasta das cópias de segurança diárias (ex.: um pendrive ou a pasta do Google Drive)
BACKUP_DIR=

# Asaas (Pix com divisão automática). Deixe em branco para não usar.
# ASAAS_ENV: vazio = sandbox de testes; "production" = dinheiro de verdade (só com confirmação do dono).
ASAAS_API_KEY=
ASAAS_ENV=
# Mesmo valor que for colocado no campo "Token de autenticação" do webhook no painel do Asaas
ASAAS_WEBHOOK_TOKEN=
